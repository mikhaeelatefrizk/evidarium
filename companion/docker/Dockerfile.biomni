# Optional experimental worker. Build only after selecting licensed model weights
# and explicit package versions. No remote model or API credential is used.
FROM python:3.12-slim
ARG BIOMNI_VERSION
ARG LLAMA_CPP_VERSION
RUN test -n "$BIOMNI_VERSION" && test -n "$LLAMA_CPP_VERSION"
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir "biomni==$BIOMNI_VERSION" "llama-cpp-python[server]==$LLAMA_CPP_VERSION"
COPY model.gguf /models/model.gguf
COPY biomni-entrypoint.sh /usr/local/bin/biomni-entrypoint
RUN chmod 755 /usr/local/bin/biomni-entrypoint && chmod 444 /models/model.gguf
ENV BIOMNI_MODEL_ENDPOINT=http://127.0.0.1:8080/v1 BIOMNI_LOCAL_MODEL=local-model PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp HF_HOME=/tmp/hf
WORKDIR /output
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/biomni-entrypoint"]
